# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
# python — 수집기마다 한 줄씩 적다가 빠뜨리기 쉬워 전역 규칙으로 둔다
__pycache__/
*.pyc
collector/usa/logs/*

.vercel
.env*

# Claude Code 개인 설정 (기기별 권한 허용 목록 — 공용 설정은 .claude/settings.json)
.claude/settings.local.json
